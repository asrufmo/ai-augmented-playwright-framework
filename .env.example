# Environment: local | staging | production
ENVIRONMENT=local

# Base URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Auth credentials (never commit real values)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test1234!
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=Admin1234!

# API Keys
API_KEY=your-api-key-here

# AI Workflow (optional - only needed for ai-workflows scripts)
ANTHROPIC_API_KEY=your-anthropic-key-here

# BrowserStack (optional — only needed to run bs-* projects)
# Get credentials from https://automate.browserstack.com/dashboard
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# CI flag
CI=false
